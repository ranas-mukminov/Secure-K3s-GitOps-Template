# Secure-K3s-GitOps-Template — environment skeleton
# Copy to .env (gitignored) or export in your shell / secret manager.
# NEVER commit real secrets.

# --- Cloud provider (Terraform) ---
HCLOUD_TOKEN=                    # Hetzner Cloud API token
# TF_VAR_hcloud_token=${HCLOUD_TOKEN}

CLOUDFLARE_API_TOKEN=            # Tunnel + DNS management
# TF_VAR_cloudflare_api_token=${CLOUDFLARE_API_TOKEN}

# --- Access ---
SSH_PUBLIC_KEY=                  # Content of ~/.ssh/id_ed25519.pub (or similar)
# TF_VAR_ssh_public_key=${SSH_PUBLIC_KEY}

CLOUDFLARE_TUNNEL_TOKEN=         # cloudflared tunnel token (no public ports)

# --- Cluster ---
SERVER_LOCATION=nbg1             # Hetzner location
SERVER_TYPE=cpx21
KUBECONFIG=                      # Path after bootstrap (never commit)

# --- Bootstrap toggles ---
SKIP_TERRAFORM_INIT=false        # true = skip terraform init in ./bootstrap.sh

# --- Optional GitOps ---
ARGOCD_REPO_URL=                 # Your private fork of this template
GITOPS_BRANCH=main
